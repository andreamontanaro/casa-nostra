# Supabase
# Project URL from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key from Supabase Dashboard > Project Settings > API.
# This key is intentionally public; do not put service_role keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
